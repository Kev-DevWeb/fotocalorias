# Orden de la cadena de proveedores de IA (se omiten los que no tienen key)
AI_PROVIDERS=github,gemini,groq,openrouter

# GitHub Models (gratis): https://github.com/settings/personal-access-tokens -> permiso "Models: read"
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenRouter (modelos :free, opcional): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-3-27b-it:free

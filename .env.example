# ── Firebase (cliente) ───────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# También lo usa el servidor para verificar la sesión de quien analiza
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Proveedores de IA ────────────────────────────────────────────────
# Orden de preferencia. Se omiten los que no tienen key.
AI_PROVIDERS=gemini,github,groq

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# GitHub Models (gratis): https://github.com/settings/personal-access-tokens -> permiso "Models: read"
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_MODELS=openai/gpt-4.1-mini

# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=qwen/qwen3.8-27b

# ── Límites de uso (opcionales; estos son los valores por defecto) ──
# USER_HOURLY_LIMIT=30
# USER_DAILY_LIMIT=150
# GUEST_DAILY_LIMIT=5

# ── Diagnóstico ──────────────────────────────────────────────────────
# Cadena aleatoria para GET /api/health?deep=1 (cabecera x-health-token).
# Debe ser la misma en Vercel y en el secreto HEALTH_TOKEN del repo en GitHub.
HEALTH_TOKEN=
